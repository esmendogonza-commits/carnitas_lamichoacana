# Copia este archivo como .env y llena los valores. NUNCA subas .env a GitHub.

# Token de acceso permanente (usuario del sistema en Meta Business).
WHATSAPP_TOKEN=
# Identificador del número de teléfono (Meta > WhatsApp > Configuración de la API).
PHONE_NUMBER_ID=
# Clave secreta de la app (Meta > Configuración de la app > Básica). Sirve para comprobar que los mensajes vienen de Meta.
APP_SECRET=
# Una contraseña larga que inventas tú (mínimo 16 caracteres). La misma se pone en Meta al configurar el webhook.
VERIFY_TOKEN=
# Tu WhatsApp personal, con lada de país y sin espacios. Ahí te llegan los avisos de pedidos. Ej: 5255XXXXXXXX
OWNER_PHONE=

# Opcional: plantilla aprobada para avisarte aunque no le hayas escrito al bot en 24 h.
OWNER_TEMPLATE_NAME=
OWNER_TEMPLATE_LANG=es_MX
# Opcional
GRAPH_API_VERSION=v23.0
PORT=3000
DATA_DIR=./data
RETENTION_DAYS=30
